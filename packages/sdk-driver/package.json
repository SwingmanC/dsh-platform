{
  "name": "@dsh-platform/sdk-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "每用户 dsh 运行时驱动:包装 @deepseek-ai/dsh-sdk-client 管理子进程与会话生命周期",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.2-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
