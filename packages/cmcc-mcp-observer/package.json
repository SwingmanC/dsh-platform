{
  "name": "@dsh-platform/cmcc-mcp-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CMCC MCP Runtime Observer:读取 ctx.tools 中 mcp__* 工具并写入观测 evidence(ack.json)(Host-only)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./probe": {
      "types": "./lib/probe.d.ts",
      "default": "./lib/probe.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}