# 复制为 .env 使用;真实密码不进版本库。

# MySQL(本地开发)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dsh_platform

# 网关
PORT=8080
# cookie 签名密钥,生成:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Redis(网关浏览器会话存储;骨架阶段可选)
# REDIS_URL=redis://127.0.0.1:6379

# 每用户 dsh 运行时布局(开发期落在 ./var 下,生产为共享卷)
DSH_HOMES_ROOT=./var/homes
DSH_WORKSPACES_ROOT=./var/workspaces

# LLM 凭据:生产环境经 KMS/t_dsh_provider_credentials 解密后注入运行时进程 env,绝不落此文件
# DEEPSEEK_API_KEY=
