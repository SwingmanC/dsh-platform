# 复制为 .env 使用;真实密码不进版本库。

# MySQL(本地开发)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dsh_platform

# 网关
PORT=8080
NODE_ENV=development
# 生产必填(≥16 字符);开发留空则每次启动生成临时密钥(重启会话失效)。
# 生成:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
# 会话有效期(小时),默认 168(7 天)
# SESSION_TTL_HOURS=168
# cookie Secure 标记;生产(HTTPS)自动开启,本地 http 保持 false
# COOKIE_SECURE=false

# 登录防爆破
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MS=900000
# LOGIN_LOCKOUT_MS=900000

# Redis(网关浏览器会话存储;未配置则降级为进程内存,仅单实例开发)
# REDIS_URL=redis://127.0.0.1:6379

# 每用户 dsh 运行时布局(相对仓库根解析;生产为共享卷)
# 注意:平台自身的 DSH_* 配置统一使用 PLATFORM_DSH_ 前缀。
# 真正的 DSH_HOME / DEEPSEEK_API_KEY 由 Supervisor 在 spawn 时注入子进程 env,
# 不写入本文件——0.1.5+ 的 dsh 会读取 cwd 下的 .env 并拒绝其中的 DSH_* 变量。
PLATFORM_DSH_HOMES_ROOT=./var/homes
PLATFORM_DSH_WORKSPACES_ROOT=./var/workspaces

# dsh launcher(0.1.5+ 必需:显式 node + CLI 入口,避免 PATH 垫片与 Node 版本问题)
# 未配置时回退到 PATH 上的 PLATFORM_DSH_BIN。
# PLATFORM_DSH_NODE_BIN=C:\path\to\node.exe
# PLATFORM_DSH_CLI_ENTRY=C:\path\to\node_modules\@deepseek-ai\dsh\lib\bin.js
# 回退:拉起实例的命令
PLATFORM_DSH_BIN=dsh

# 拓扑:dsh 0.1.1-rc.2 前端用根绝对路径,无法挂子路径 → UI 需专属 authority。
# 平台首页 authority(登录/历史会话)
PLATFORM_AUTHORITY=localhost:5173
PLATFORM_SCHEME=http
# dsh Web UI 专属 authority(浏览器直接访问根路径;作为实例 --trusted-host)
# 开发:用网关端口(同 host 跨端口共享 cookie,无需 DNS);生产:dsh.corp.example
PLATFORM_DSH_UI_AUTHORITY=localhost:8080
# 跨 authority 共享 sid;同 host 跨端口留空;生产跨子域用 .<父域>(如 .corp.example)
# SESSION_COOKIE_DOMAIN=
PLATFORM_GATEWAY_ORIGIN=http://localhost:5173
# 未安装 dsh 时的代理联调:把 dsh UI 固定代理到该上游(跳过进程拉起)
# PLATFORM_DSH_MOCK_UPSTREAM=http://127.0.0.1:3080

# LLM 凭据:生产环境经 KMS/t_dsh_provider_credentials 解密后注入运行时进程 env,绝不落此文件
# DEEPSEEK_API_KEY=

# 前端展示的 dsh UI 地址(Vite 构建/开发时读取)
# VITE_DSH_UI_URL=http://dsh.localhost:8080/

# --- Phase 06:MCP Runtime 治理 ---
# credential 加密 master key(AES-256-GCM,32 字节 hex/base64)。
# 未配置时 MCP credential 保存会失败(其他功能不受影响)。绝不提交真实 key。
# 生成:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PLATFORM_SECRET_ENCRYPTION_KEY=
# 普通用户 stdio 默认禁用(arbitrary process execution carrier);Phase 06 保持 false。
# PLATFORM_MCP_ALLOW_STDIO=false
# streamable-http origin 白名单(逗号分隔)。canary 本地 fixture 需显式放行 loopback。
# PLATFORM_MCP_ALLOWED_ORIGINS=https://mcp.corp.example
# 仅 canary/test 放行 127.0.0.1/localhost(生产默认 false)。
# PLATFORM_MCP_ALLOW_LOOPBACK=false
# MCP 投影根(默认与 dsh 投影同根)
# PLATFORM_MCP_PROJECTIONS_ROOT=./var/projections
# 每工具调用超时(毫秒)
# PLATFORM_MCP_TOOL_TIMEOUT_MS=60000
# canary MCP fixture 鉴权 token(仅测试;生产不使用)
# MCP_FIXTURE_TOKEN=

# --- Phase 07:Memory Runtime 治理 ---
# 投影根(默认与 dsh 投影同根)
# PLATFORM_MEMORY_PROJECTIONS_ROOT=./var/projections
# bounded recall 预算
# PLATFORM_MEMORY_MAX_RECALL_ITEMS=8
# PLATFORM_MEMORY_MAX_RECALL_BYTES=4096
# PLATFORM_MEMORY_MAX_ITEM_BYTES=512
# team memory runtime(默认禁用;仅 personal 投影)
# PLATFORM_MEMORY_TEAM_RUNTIME=false
# 确定性显式自动提取(默认开启)
# PLATFORM_MEMORY_AUTO_EXTRACTION=true
