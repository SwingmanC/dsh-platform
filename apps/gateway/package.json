{
  "name": "@dsh-platform/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh-platform 网关/BFF:认证、/app/* 反代、Supervisor、MySQL 访问",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "hash-password": "tsx src/tools/hash-password.ts"
  },
  "dependencies": {
    "@dsh-platform/shared": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/http-proxy": "^11.6.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.1.0",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.3",
    "mysql2": "^3.11.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
